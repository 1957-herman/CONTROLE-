# URL pública do site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.fisarq.pt

# Envio de e-mails do formulário de contacto (opcional — Resend)
# Sem estas variáveis, os pedidos são validados e registados no log do servidor.
RESEND_API_KEY=
CONTACT_TO_EMAIL=geral@fisarq.pt
CONTACT_FROM_EMAIL="FISARQ Website <website@fisarq.pt>"
